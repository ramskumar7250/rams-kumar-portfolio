{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "server.js": {
      "includeFiles": "{assets/**,projects/**,*.html}"
    },
    "api/*.js": {
      "includeFiles": "{assets/**,projects/**,*.html}"
    }
  },
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/projects/",
      "destination": "/projects.html"
    }
  ]
}